    public static func GetRaidPreset(location: RaidLocation, opt planned: Bool) -> ref<RaidPreset> {
        let presets: array<ref<RaidPreset>>;
        switch location {
            case RaidLocation.SantoDomingo:
                presets = planned ? RaidPresets.SantoDomingoPlannedPresets() : RaidPresets.SantoDomingoPresets();
                break;
            case RaidLocation.Badlands:
                presets = planned ? RaidPresets.BadlandsPlannedPresets() : RaidPresets.BadlandsPresets();
                break;
            case RaidLocation.Westbrook:
                presets = planned ? RaidPresets.WestbrookPlannedPresets() : RaidPresets.WestbrookPresets();
                break;
            case RaidLocation.Heywood:
                presets = planned ? RaidPresets.HeywoodPlannedPresets() : RaidPresets.HeywoodPresets();
                break;
            case RaidLocation.Pacifica:
                presets = planned ? RaidPresets.PacificaPlannedPresets() : RaidPresets.PacificaPresets();
                break;
            default:
                presets = planned ? RaidPresets.WatsonPlannedPresets() : RaidPresets.WatsonPresets();
                break;
        }
        let idx = RandRange(0, ArraySize(presets));
        return presets[idx];
    }
}

