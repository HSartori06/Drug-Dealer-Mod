module DrugDealer.Job.Raid

import DrugDealer.Organization.{Organization}

// -----------------------------------------------------------------------------
// RaidPresets - Drug Dealer
// -----------------------------------------------------------------------------
public class RaidPreset {
    public let organization: Organization;
    public let characters: array<TweakDBID>;

    public static func Create(organization: Organization, characters: array<TweakDBID>) -> ref<RaidPreset> {
        let preset = new RaidPreset();
        preset.organization = organization;
        preset.characters = characters;
        return preset;
    }
}

