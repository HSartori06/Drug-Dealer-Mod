    public static func GetBuyerLocation(location: BuyerLocation) -> ref<LocationWithOrientation> {
        switch location {
            case BuyerLocation.Watson:
                return BuyerLocations.GetRandomLocation(BuyerLocations.WatsonLocations());
            case BuyerLocation.SantoDomingo:
                return BuyerLocations.GetRandomLocation(BuyerLocations.SantoDomingoLocations());
            case BuyerLocation.Badlands:
                return BuyerLocations.GetRandomLocation(BuyerLocations.BadlandsLocations());
            case BuyerLocation.Westbrook:
                return BuyerLocations.GetRandomLocation(BuyerLocations.WestbrookLocations());
            case BuyerLocation.WestbrookHighSociety:
                return BuyerLocations
                    .GetRandomLocation(BuyerLocations.WestbrookHighSocietyLocations());
            case BuyerLocation.Heywood:
                return BuyerLocations.GetRandomLocation(BuyerLocations.HeywoodLocations());
            case BuyerLocation.Pacifica:
                return BuyerLocations.GetRandomLocation(BuyerLocations.PacificaLocations());
            default:
                return BuyerLocations.GetRandomLocation(BuyerLocations.WatsonLocations());
        }
    }

    private static func GetRandomLocation(buyerLocations: array<ref<LocationWithOrientation>>) -> ref<LocationWithOrientation> {
        let idx = RandRange(0, ArraySize(buyerLocations));
        return buyerLocations[idx];
    }
}

