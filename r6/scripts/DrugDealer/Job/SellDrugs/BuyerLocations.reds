module DrugDealer.Job.SellDrugs

import NightlyNow.Utils.LocationWithOrientation
import DrugDealer.State.TurfLocation

// -----------------------------------------------------------------------------
// BuyerLocations - Drug Dealer
// -----------------------------------------------------------------------------
public enum BuyerLocation {
    Watson = 0,
    SantoDomingo = 1,
    Badlands = 2,
    Westbrook = 3,
    WestbrookHighSociety = 4,
    Heywood = 5,
    Pacifica = 6,
}

public func ConvertToTurfLocation(buyerLocation: BuyerLocation) -> TurfLocation {
    if Equals(buyerLocation, BuyerLocation.Watson) {
        return TurfLocation.Watson;
    }
    if Equals(buyerLocation, BuyerLocation.SantoDomingo) {
        return TurfLocation.SantoDomingo;
    }
    if Equals(buyerLocation, BuyerLocation.Badlands) {
        return TurfLocation.Badlands;
    }
    if Equals(buyerLocation, BuyerLocation.Heywood) {
        return TurfLocation.Heywood;
    }
    if Equals(buyerLocation, BuyerLocation.Pacifica) {
        return TurfLocation.Pacifica;
    }
    return TurfLocation.Westbrook;
}

public func ConvertToBuyerLocation(turfLocation: TurfLocation) -> BuyerLocation {
    if Equals(turfLocation, TurfLocation.Watson) {
        return BuyerLocation.Watson;
    }
    if Equals(turfLocation, TurfLocation.SantoDomingo) {
        return BuyerLocation.SantoDomingo;
    }
    if Equals(turfLocation, TurfLocation.Badlands) {
        return BuyerLocation.Badlands;
    }
    if Equals(turfLocation, TurfLocation.Heywood) {
        return BuyerLocation.Heywood;
    }
    if Equals(turfLocation, TurfLocation.Pacifica) {
        return BuyerLocation.Pacifica;
    }
    return BuyerLocation.Westbrook;
}

