<?xml version="1.0"?>
<bindings>

	<!-- Base game Input Contexts -->
	<context name="Exploration" append="true" >
        <action name="DDInteractionActionMain" map="DDInteractionMappingMain" />
        <action name="DDInteractionActionSecondary" map="DDInteractionMappingSecondary" />
    </context>

	<!-- Mappings -->
	<mapping name="DDInteractionMappingMain" type="Button">
		<button id="IK_F" />
		<button id="IK_Pad_X_SQUARE" />
	</mapping>
	<mapping name="DDInteractionMappingSecondary" type="Button">
		<button id="IK_R" />
        <button id="IK_Pad_B_CIRCLE" />
	</mapping>
    
	<!-- Hold Actions -->
    <hold action="DDInteractionActionMain" timeout="1.0" />
    <hold action="DDInteractionActionSecondary" timeout="1.0" />
</bindings>